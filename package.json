{
  "name": "coding-statistics",
  "displayName": "Coding Statistics",
  "description": "Track coding time, edits, projects, and languages with sync to CodingStats.",
  "icon": "icon.png",
  "publisher": "PedroKlein",
  "version": "2.0.2",
  "engines": {
    "vscode": "^1.99.0"
  },
  "categories": [
    "Other"
  ],
  "authentication": [
    {
      "id": "github",
      "label": "GitHub"
    }
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "catCoding.start",
        "title": "Start new cat coding session",
        "category": "Cat Coding"
      },
      {
        "command": "codingstatistics.openFrontend",
        "title": "Open CodingStats Dashboard",
        "category": "Coding Statistics"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Coding Statistics",
      "properties": {
        "codingstatistics.apiUrl": {
          "type": "string",
          "default": "https://api.codingstats.me",
          "description": "Base API URL used by the extension."
        },
        "codingstatistics.statusBar.mode": {
          "type": "string",
          "enum": [
            "compact",
            "balanced",
            "deep"
          ],
          "default": "balanced",
          "description": "Status bar display mode (compact, balanced, or deep)."
        },
        "codingstatistics.statusBar.primaryMetric": {
          "type": "string",
          "enum": [
            "time",
            "manualLines",
            "netLines",
            "assistedShare",
            "productivityScore"
          ],
          "default": "time",
          "description": "Primary metric displayed in the status bar."
        },
        "codingstatistics.statusBar.timeFormat": {
          "type": "string",
          "enum": [
            "human",
            "hhmmss",
            "minutes"
          ],
          "default": "human",
          "description": "Time format used in the status bar and tooltip."
        }
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/PedroKleinDavila/statistics-extension.git"
  },
  "scripts": {
    "vscode:prepublish": "yarn run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "yarn run compile && yarn run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "^1.99.0",
    "@typescript-eslint/eslint-plugin": "^8.28.0",
    "@typescript-eslint/parser": "^8.28.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "eslint": "^9.23.0",
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "axios": "^1.9.0"
  }
}